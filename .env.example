# Cloudflare Access service token for local development with remote bindings and
# the production-backup card. Keep the real values in .env and never commit it.
CLOUDFLARE_ACCESS_CLIENT_ID=your-access-service-token-client-id
CLOUDFLARE_ACCESS_CLIENT_SECRET=your-access-service-token-client-secret
# Must match the LOCAL_BACKUP_BRIDGE_SECRET stored in the deployed Worker.
LOCAL_PRODUCTION_BACKUP_BRIDGE_SECRET=generate-a-long-random-secret
