/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "free-spirit-dance",
	"keep_vars": true,
	"secrets": { "required": ["BACKUP_API_TOKEN", "LOCAL_BACKUP_BRIDGE_SECRET"] },
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["nodejs_als"],
	"main": "worker.ts",
	"vars": {
		"PUBLIC_QR_BASE_URL": "https://go.alexandru-croitoriu.dev",
		"BACKUP_ACCOUNT_ID": "464b96dc41a8bb50dc0ec48941a172e5",
		"BACKUP_PRODUCTION_DATABASE_ID": "6de090fa-ec37-493a-9818-a142f35552ae"
	},
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "FS-Dance-Db",
			"database_id": "6de090fa-ec37-493a-9818-a142f35552ae",
			"remote": true
		}
	],
	"durable_objects": { "bindings": [{ "name": "PRODUCTION_BACKUPS", "class_name": "ProductionBackupCoordinator" }, { "name": "LOCAL_BACKUPS", "class_name": "LocalBackupCoordinator" }] },
	"migrations": [{ "tag": "production-backups-v1", "new_sqlite_classes": ["ProductionBackupCoordinator"] }, { "tag": "local-backups-v1", "new_sqlite_classes": ["LocalBackupCoordinator"] }],
	"workflows": [{ "binding": "BACKUP_WORKFLOW", "name": "fsd-production-backups", "class_name": "ProductionBackupWorkflow" }],
	"triggers": { "crons": ["* * * * *"] },
	"r2_buckets": [
		{ "binding": "BACKUP_BUCKET", "bucket_name": "fs-dance-backups" },
		{
			"binding": "STUDENT_IMAGES",
			"bucket_name": "fs-dance-media",
			"remote": true
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
