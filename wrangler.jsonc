/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "free-spirit-dance",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["nodejs_als"],
	"main": "worker.ts",
	"vars": {
		"PUBLIC_QR_BASE_URL": "https://go.alexandru-croitoriu.dev"
	},
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "free-spirit-dance-db",
			"database_id": "1b6b1660-4abe-4735-91f0-c570d9f7193e",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "STUDENT_IMAGES",
			"bucket_name": "free-spirit-dance-student-images",
			"remote": true
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
