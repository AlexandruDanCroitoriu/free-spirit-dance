                </mxCell>
                <mxCell id="payment_presets-amount_minor" value="amount_minor : INTEGER  [NN]" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;overflow=hidden;" parent="payment_presets" vertex="1" tooltip="amount_minor: INTEGER; NOT NULL">
                    <mxGeometry x="0" y="100" width="560" height="28" as="geometry" />
