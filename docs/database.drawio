                <mxCell id="attendance-complimentary_by" value="complimentary_by : TEXT" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;overflow=hidden;" parent="attendance" vertex="1" tooltip="complimentary_by: TEXT; nullable / SQLite primary-key rules">
