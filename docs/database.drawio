                </mxCell>
                <mxCell id="attendance-student_id" value="student_id : INTEGER  [FK, NN] → students.id" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;fontSize=12;fillColor=#eff6ff;overflow=hidden;" parent="attendance" vertex="1" tooltip="student_id: INTEGER; NOT NULL; REFERENCES students(id) ON DELETE NO ACTION ON UPDATE NO ACTION">
