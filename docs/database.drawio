                <mxCell id="attendance-class_id" value="class_id : INTEGER  [FK] → classes.id" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;overflow=hidden;" parent="attendance" vertex="1" tooltip="class_id: INTEGER; nullable / SQLite primary-key rules; REFERENCES classes(id) ON DELETE NO ACTION ON UPDATE NO ACTION">
