                <mxCell id="payment_presets" value="payment_presets" style="swimlane;html=0;startSize=44;horizontal=1;rounded=1;arcSize=6;collapsible=0;fontFamily=Helvetica;fontSize=18;fontStyle=1;align=left;spacingLeft=12;fillColor=#f0fdf4;strokeColor=#16a34a;" parent="1" vertex="1" tooltip="CREATE TABLE payment_presets (&#10;  id INTEGER PRIMARY KEY AUTOINCREMENT,&#10;  name TEXT NOT NULL CHECK (length(trim(name)) BETWEEN 1 AND 120),&#10;  amount_minor INTEGER NOT NULL CHECK (typeof(amount_minor) = 'integer' AND amount_minor BETWEEN 1 AND 99999999)&#10;);&#10;CREATE UNIQUE INDEX payment_presets_name_idx ON payment_presets (name COLLATE NOCASE);">
                    <mxGeometry x="1520" y="710" width="560" height="128" as="geometry" />
                </mxCell>
