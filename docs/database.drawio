                <mxCell id="payment_preset_courses" value="payment_preset_courses" style="swimlane;html=0;startSize=44;horizontal=1;rounded=1;arcSize=6;collapsible=0;fontFamily=Helvetica;fontSize=18;fontStyle=1;align=left;spacingLeft=12;fillColor=#f0fdf4;strokeColor=#16a34a;" parent="1" vertex="1" tooltip="CREATE TABLE payment_preset_courses (&#10;  preset_id INTEGER NOT NULL REFERENCES payment_presets(id) ON DELETE CASCADE,&#10;  course_id INTEGER NOT NULL REFERENCES courses(id),&#10;  allowance INTEGER NOT NULL CHECK (typeof(allowance) = 'integer' AND allowance BETWEEN 1 AND 10000),&#10;  PRIMARY KEY (preset_id, course_id)&#10;);&#10;CREATE INDEX payment_preset_courses_course_idx ON payment_preset_courses (course_id);">
                    <mxGeometry x="1520" y="868" width="560" height="128" as="geometry" />
