                </mxCell>
                <mxCell id="attendance-complimentary_at" value="complimentary_at : TEXT" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;fontSize=12;fillColor=#eff6ff;overflow=hidden;" parent="attendance" vertex="1" tooltip="complimentary_at: TEXT; nullable / SQLite primary-key rules">
                    <mxGeometry x="0" y="408" width="560" height="28" as="geometry" />
                </mxCell>
                <mxCell id="student_course_balances" value="student_course_balances · VIEW" style="swimlane;html=0;startSize=44;horizontal=1;rounded=1;arcSize=6;collapsible=0;fontFamily=Helvetica;fontSize=18;fontStyle=1;align=left;spacingLeft=12;fillColor=#f5f3ff;strokeColor=#8b5cf6;" parent="1" vertex="1" tooltip="CREATE VIEW student_course_balances AS&#10;WITH pairs AS (&#10;  SELECT student_id, course_id FROM student_courses&#10;  UNION SELECT student_id, course_id FROM attendance&#10;  UNION SELECT p.student_id, a.course_id FROM payment_course_allowances a JOIN student_payments p ON p.id = a.payment_id&#10;), totals AS (&#10;  SELECT pairs.student_id, pairs.course_id,&#10;    (SELECT COUNT(*) FROM attendance a WHERE a.student_id = pairs.student_id AND a.course_id = pairs.course_id) AS attendance_count,&#10;    (SELECT COALESCE(SUM(a.allowance), 0) FROM payment_course_allowances a JOIN student_payments p ON p.id = a.payment_id WHERE p.student_id = pairs.student_id AND a.course_id = pairs.course_id) AS paid_allowance&#10;  FROM pairs&#10;)&#10;SELECT student_id, course_id, attendance_count, paid_allowance,&#10;  paid_allowance - attendance_count AS remaining_allowance,&#10;  MAX(attendance_count - paid_allowance, 0) AS excess_attendance FROM totals;">
                    <mxGeometry x="2260" y="636" width="560" height="212" as="geometry" />
                </mxCell>
                <mxCell id="student_course_balances-student_id" value="student_id : INTEGER" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;overflow=hidden;" parent="student_course_balances" vertex="1" tooltip="student_id: INTEGER; nullable / SQLite primary-key rules">
                    <mxGeometry x="0" y="44" width="560" height="28" as="geometry" />
                </mxCell>
                <mxCell id="student_course_balances-course_id" value="course_id : INTEGER" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;fontSize=12;fillColor=#f5f3ff;overflow=hidden;" parent="student_course_balances" vertex="1" tooltip="course_id: INTEGER; nullable / SQLite primary-key rules">
                    <mxGeometry x="0" y="72" width="560" height="28" as="geometry" />
                </mxCell>
                <mxCell id="student_course_balances-attendance_count" value="attendance_count : derived" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;overflow=hidden;" parent="student_course_balances" vertex="1" tooltip="attendance_count: derived expression; nullable / SQLite primary-key rules">
                    <mxGeometry x="0" y="100" width="560" height="28" as="geometry" />
                </mxCell>
                <mxCell id="student_course_balances-paid_allowance" value="paid_allowance : derived" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;fontSize=12;fillColor=#f5f3ff;overflow=hidden;" parent="student_course_balances" vertex="1" tooltip="paid_allowance: derived expression; nullable / SQLite primary-key rules">
                    <mxGeometry x="0" y="128" width="560" height="28" as="geometry" />
                </mxCell>
                <mxCell id="student_course_balances-remaining_allowance" value="remaining_allowance : derived" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;overflow=hidden;" parent="student_course_balances" vertex="1" tooltip="remaining_allowance: derived expression; nullable / SQLite primary-key rules">
                    <mxGeometry x="0" y="156" width="560" height="28" as="geometry" />
                </mxCell>
                <mxCell id="student_course_balances-excess_attendance" value="excess_attendance : derived" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;fontSize=12;fillColor=#f5f3ff;overflow=hidden;" parent="student_course_balances" vertex="1" tooltip="excess_attendance: derived expression; nullable / SQLite primary-key rules">
                    <mxGeometry x="0" y="184" width="560" height="28" as="geometry" />
                </mxCell>
                <mxCell id="school_payment_records" value="school_payment_records · VIEW" style="swimlane;html=0;startSize=44;horizontal=1;rounded=1;arcSize=6;collapsible=0;fontFamily=Helvetica;fontSize=18;fontStyle=1;align=left;spacingLeft=12;fillColor=#f5f3ff;strokeColor=#8b5cf6;" parent="1" vertex="1" tooltip="CREATE VIEW school_payment_records AS&#10;SELECT p.id, 'course' AS purpose, NULL AS practice_id, NULL AS practice_description,&#10;  p.student_id, p.paid_on, p.amount_minor, p.recorded_by, p.given_to_school&#10;FROM student_payments p&#10;UNION ALL&#10;SELECT a.id, 'practice_donation', a.practice_id, 'Practice party · ' || s.starts_at,&#10;  a.student_id, a.donation_paid_on, a.donation_amount_minor, a.donation_recorded_by, a.donation_given_to_school&#10;FROM practice_attendance a JOIN practice_parties s ON s.id = a.practice_id&#10;WHERE a.donation_amount_minor IS NOT NULL;">
                    <mxGeometry x="2260" y="878" width="560" height="296" as="geometry" />
                </mxCell>
                <mxCell id="group-4" value="PRACTICE PARTIES" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#475569;" parent="1" vertex="1">
                    <mxGeometry x="3000" y="120" width="560" height="36" as="geometry" />
                </mxCell>
                <mxCell id="practice_parties" value="practice_parties" style="swimlane;html=0;startSize=44;horizontal=1;rounded=1;arcSize=6;collapsible=0;fontFamily=Helvetica;fontSize=18;fontStyle=1;align=left;spacingLeft=12;fillColor=#fff7ed;strokeColor=#ea580c;" parent="1" vertex="1" tooltip="CREATE TABLE practice_parties (&#10;  id INTEGER PRIMARY KEY AUTOINCREMENT,&#10;  starts_at TEXT NOT NULL,&#10;  starts_utc TEXT NOT NULL,&#10;  duration_minutes INTEGER NOT NULL CHECK (duration_minutes BETWEEN 1 AND 1440),&#10;  cancelled INTEGER NOT NULL DEFAULT 0 CHECK (cancelled IN (0, 1)),&#10;  revision INTEGER NOT NULL DEFAULT 0,&#10;  recorded_by TEXT NOT NULL REFERENCES admin_profiles(email),&#10;  recorded_at TEXT NOT NULL,&#10;  request_key TEXT NOT NULL UNIQUE&#10;, request_hash TEXT, last_request_key TEXT, last_request_hash TEXT);&#10;CREATE INDEX practice_parties_date_idx ON practice_parties (starts_at, id);&#10;CREATE TRIGGER practice_revision_matches BEFORE UPDATE OF revision ON practice_parties&#10;WHEN NEW.revision != OLD.revision + 1&#10;BEGIN SELECT RAISE(ABORT, 'Practice party changed. Reload before saving.'); END;">
                    <mxGeometry x="3000" y="170" width="560" height="380" as="geometry" />
                </mxCell>
                <mxCell id="practice_attendance" value="practice_attendance" style="swimlane;html=0;startSize=44;horizontal=1;rounded=1;arcSize=6;collapsible=0;fontFamily=Helvetica;fontSize=18;fontStyle=1;align=left;spacingLeft=12;fillColor=#fff7ed;strokeColor=#ea580c;" parent="1" vertex="1" tooltip="CREATE TABLE &quot;practice_attendance&quot; (&#10;  id INTEGER PRIMARY KEY AUTOINCREMENT,&#10;  student_id INTEGER NOT NULL REFERENCES students(id),&#10;  practice_id INTEGER NOT NULL REFERENCES practice_parties(id),&#10;  recorded_by TEXT NOT NULL REFERENCES admin_profiles(email),&#10;  recorded_at TEXT NOT NULL,&#10;  notes TEXT NOT NULL DEFAULT '',&#10;  donation_amount_minor INTEGER CHECK (donation_amount_minor IS NULL OR (typeof(donation_amount_minor) = 'integer' AND donation_amount_minor BETWEEN 1 AND 99999999)),&#10;  donation_paid_on TEXT,&#10;  donation_notes TEXT NOT NULL DEFAULT '',&#10;  donation_recorded_by TEXT REFERENCES admin_profiles(email),&#10;  donation_recorded_at TEXT,&#10;  donation_given_to_school INTEGER NOT NULL DEFAULT 0 CHECK (donation_given_to_school IN (0, 1)),&#10;  UNIQUE (student_id, practice_id),&#10;  CHECK (&#10;    (donation_amount_minor IS NULL AND donation_paid_on IS NULL AND donation_recorded_by IS NULL AND donation_recorded_at IS NULL AND donation_notes = '' AND donation_given_to_school = 0)&#10;    OR (donation_amount_minor IS NOT NULL AND donation_paid_on IS NOT NULL AND donation_recorded_by IS NOT NULL AND donation_recorded_at IS NOT NULL)&#10;  )&#10;);&#10;CREATE INDEX practice_attendance_donation_date_idx ON practice_attendance (donation_paid_on, id) WHERE donation_amount_minor IS NOT NULL;&#10;CREATE TRIGGER practice_attendance_keeps_donation BEFORE DELETE ON practice_attendance&#10;WHEN OLD.donation_amount_minor IS NOT NULL&#10;BEGIN SELECT RAISE(ABORT, 'Remove the donation before removing attendance.'); END;&#10;CREATE INDEX practice_attendance_party_idx ON practice_attendance (practice_id, id);">
                    <mxGeometry x="3000" y="620" width="560" height="380" as="geometry" />
                </mxCell>
                <mxCell id="legend" value="PK = primary key · FK = foreign key · NN = NOT NULL · Solid crow’s-foot = foreign key · Dashed arrow = view dependency · Hover over tables for complete SQL." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#475569;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1870" width="3520" height="36" as="geometry" />
                </mxCell>
                <mxCell id="notes" value="Practice donations live on attendance and appear in student activity and school payment totals. No practice change history is stored. Hover over tables for full SQL." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#475569;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1910" width="3520" height="36" as="geometry" />
                </mxCell>
                <mxCell id="sql-reference-layer" value="SQL definitions (reference)" parent="0" visible="0" />
                <mxCell id="sql-students" value="CREATE TABLE students (&#10;  id INTEGER PRIMARY KEY AUTOINCREMENT,&#10;  first_name TEXT NOT NULL,&#10;  last_name TEXT NOT NULL,&#10;  email TEXT NOT NULL,&#10;  phone TEXT NOT NULL DEFAULT '',&#10;  picture TEXT,&#10;  active INTEGER NOT NULL DEFAULT 1 CHECK (active IN (0, 1))&#10;);&#10;CREATE INDEX students_name_idx ON students (last_name, first_name);&#10;CREATE UNIQUE INDEX students_phone_unique_idx&#10;ON students (trim(phone))&#10;WHERE trim(phone) &lt;&gt; '';" style="text;html=0;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;" parent="sql-reference-layer" vertex="1">
                    <mxGeometry x="60" y="180" width="2000" height="680" as="geometry" />
                </mxCell>
                <mxCell id="sql-courses" value="CREATE TABLE &quot;courses&quot; (&#10;  id INTEGER PRIMARY KEY AUTOINCREMENT,&#10;  name TEXT NOT NULL CHECK (length(trim(name)) &gt; 0)&#10;, start_date TEXT, end_date TEXT CHECK (end_date IS NULL OR start_date IS NULL OR end_date &gt;= start_date));&#10;CREATE INDEX courses_name_idx ON courses (name COLLATE NOCASE);" style="text;html=0;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;" parent="sql-reference-layer" vertex="1">
                    <mxGeometry x="60" y="880" width="2000" height="680" as="geometry" />
                </mxCell>
                <mxCell id="sql-student_courses" value="CREATE TABLE student_courses (&#10;  student_id INTEGER NOT NULL REFERENCES students(id) ON DELETE CASCADE,&#10;  course_id INTEGER NOT NULL REFERENCES courses(id),&#10;  PRIMARY KEY (student_id, course_id)&#10;);&#10;CREATE INDEX student_courses_course_idx ON student_courses (course_id);" style="text;html=0;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;" parent="sql-reference-layer" vertex="1">
                    <mxGeometry x="60" y="1580" width="2000" height="680" as="geometry" />
                </mxCell>
                <mxCell id="sql-course_schedule" value="CREATE TABLE course_schedule (&#10;  id INTEGER PRIMARY KEY AUTOINCREMENT,&#10;  course_id INTEGER NOT NULL REFERENCES courses(id),&#10;  day_of_week TEXT NOT NULL CHECK (day_of_week IN ('Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday')),&#10;  start_time TEXT NOT NULL CHECK (start_time GLOB '[0-2][0-9]:[0-5][0-9]' AND CAST(substr(start_time, 1, 2) AS INTEGER) &lt;= 23),&#10;  end_time TEXT NOT NULL CHECK (end_time GLOB '[0-2][0-9]:[0-5][0-9]' AND CAST(substr(end_time, 1, 2) AS INTEGER) &lt;= 23),&#10;  CHECK (end_time &gt; start_time),&#10;  UNIQUE (course_id, day_of_week, start_time)&#10;);" style="text;html=0;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;" parent="sql-reference-layer" vertex="1">
                    <mxGeometry x="60" y="2280" width="2000" height="680" as="geometry" />
                </mxCell>
                <mxCell id="sql-attendance" value="CREATE TABLE attendance (&#10;  id INTEGER PRIMARY KEY AUTOINCREMENT,&#10;  student_id INTEGER NOT NULL REFERENCES students(id),&#10;  course_id INTEGER NOT NULL REFERENCES courses(id),&#10;  course_name TEXT NOT NULL,&#10;  attended_at TEXT NOT NULL,&#10;  recorded_by TEXT NOT NULL COLLATE NOCASE REFERENCES admin_profiles(email),&#10;  recorded_at TEXT,&#10;  notes TEXT NOT NULL DEFAULT '',&#10;  request_key TEXT UNIQUE,&#10;  request_payload TEXT&#10;, class_id INTEGER REFERENCES classes(id), complimentary INTEGER NOT NULL DEFAULT 0 CHECK (complimentary IN (0, 1)), complimentary_by TEXT, complimentary_at TEXT);&#10;CREATE INDEX attendance_admin_idx ON attendance (recorded_by);&#10;CREATE INDEX attendance_class_idx ON attendance (class_id);&#10;CREATE UNIQUE INDEX attendance_class_unique_idx ON attendance (student_id, course_id, attended_at) WHERE request_key IS NOT NULL;&#10;CREATE INDEX attendance_course_idx ON attendance (course_id, attended_at);&#10;CREATE TRIGGER attendance_requires_active_class BEFORE INSERT ON attendance&#10;WHEN NOT EXISTS (SELECT 1 FROM classes WHERE id = NEW.class_id AND cancelled = 0&#10;AND course_id = NEW.course_id AND class_date = substr(NEW.attended_at, 1, 10) AND start_time = substr(NEW.attended_at, 12, 5))&#10;BEGIN SELECT RAISE(ABORT, 'Class is cancelled or invalid'); END;&#10;CREATE INDEX attendance_student_idx ON attendance (student_id, attended_at, id);" style="text;html=0;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;" parent="sql-reference-layer" vertex="1">
                    <mxGeometry x="60" y="2980" width="2000" height="680" as="geometry" />
                </mxCell>
                <mxCell id="sql-student_payments" value="CREATE TABLE student_payments (&#10;  id INTEGER PRIMARY KEY AUTOINCREMENT,&#10;  student_id INTEGER NOT NULL REFERENCES students(id),&#10;  paid_on TEXT NOT NULL,&#10;  amount_minor INTEGER NOT NULL CHECK (typeof(amount_minor) = 'integer' AND amount_minor BETWEEN 1 AND 99999999),&#10;  notes TEXT NOT NULL DEFAULT '',&#10;  recorded_by TEXT NOT NULL COLLATE NOCASE REFERENCES admin_profiles(email),&#10;  recorded_at TEXT NOT NULL,&#10;  request_key TEXT NOT NULL UNIQUE,&#10;  request_payload TEXT NOT NULL&#10;, given_to_school INTEGER NOT NULL DEFAULT 0 CHECK (given_to_school IN (0, 1)), received_method TEXT NOT NULL DEFAULT '');&#10;CREATE INDEX student_payments_admin_idx ON student_payments (recorded_by);&#10;CREATE INDEX student_payments_date_idx ON student_payments (paid_on DESC, id DESC);&#10;CREATE INDEX student_payments_student_idx ON student_payments (student_id, paid_on, id);" style="text;html=0;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;" parent="sql-reference-layer" vertex="1">
                    <mxGeometry x="60" y="3680" width="2000" height="680" as="geometry" />
                </mxCell>
                <mxCell id="sql-payment_course_allowances" value="CREATE TABLE payment_course_allowances (&#10;  payment_id INTEGER NOT NULL REFERENCES student_payments(id),&#10;  course_id INTEGER NOT NULL REFERENCES courses(id),&#10;  course_name TEXT NOT NULL,&#10;  allowance INTEGER NOT NULL CHECK (typeof(allowance) = 'integer' AND allowance BETWEEN 1 AND 10000),&#10;  PRIMARY KEY (payment_id, course_id)&#10;);&#10;CREATE INDEX payment_course_allowances_course_idx ON payment_course_allowances (course_id);" style="text;html=0;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;" parent="sql-reference-layer" vertex="1">
                    <mxGeometry x="60" y="4380" width="2000" height="680" as="geometry" />
                </mxCell>
                <mxCell id="sql-student_course_balances" value="CREATE VIEW student_course_balances AS&#10;WITH pairs AS (&#10;  SELECT student_id, course_id FROM student_courses&#10;  UNION SELECT student_id, course_id FROM attendance&#10;  UNION SELECT p.student_id, a.course_id FROM payment_course_allowances a JOIN student_payments p ON p.id = a.payment_id&#10;), totals AS (&#10;  SELECT pairs.student_id, pairs.course_id,&#10;    (SELECT COUNT(*) FROM attendance a WHERE a.student_id = pairs.student_id AND a.course_id = pairs.course_id) AS attendance_count,&#10;    (SELECT COALESCE(SUM(a.allowance), 0) FROM payment_course_allowances a JOIN student_payments p ON p.id = a.payment_id WHERE p.student_id = pairs.student_id AND a.course_id = pairs.course_id) AS paid_allowance&#10;  FROM pairs&#10;)&#10;SELECT student_id, course_id, attendance_count, paid_allowance,&#10;  paid_allowance - attendance_count AS remaining_allowance,&#10;  MAX(attendance_count - paid_allowance, 0) AS excess_attendance FROM totals;" style="text;html=0;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;" parent="sql-reference-layer" vertex="1">
                    <mxGeometry x="60" y="5080" width="2000" height="680" as="geometry" />
                </mxCell>
                <mxCell id="sql-admin_profiles" value="CREATE TABLE admin_profiles (&#10;  email TEXT PRIMARY KEY COLLATE NOCASE,&#10;  name TEXT NOT NULL,&#10;  picture TEXT&#10;);" style="text;html=0;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;" parent="sql-reference-layer" vertex="1">
                    <mxGeometry x="60" y="5780" width="2000" height="680" as="geometry" />
                </mxCell>
                <mxCell id="sql-administrator_payment_methods" value="CREATE TABLE administrator_payment_methods (&#10;  email TEXT NOT NULL COLLATE NOCASE REFERENCES admin_profiles(email),&#10;  method TEXT NOT NULL COLLATE NOCASE CHECK (length(method) BETWEEN 1 AND 50),&#10;  PRIMARY KEY (email, method)&#10;);" style="text;html=0;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;" parent="sql-reference-layer" vertex="1"><mxGeometry x="60" y="6380" width="2000" height="300" as="geometry" /></mxCell>
                <mxCell id="sql-administrator_permissions" value="CREATE TABLE administrator_permissions (&#10;  email TEXT PRIMARY KEY COLLATE NOCASE,&#10;  can_dashboard INTEGER NOT NULL DEFAULT 0 CHECK (can_dashboard IN (0, 1)),&#10;  can_students INTEGER NOT NULL DEFAULT 0 CHECK (can_students IN (0, 1)),&#10;  can_courses INTEGER NOT NULL DEFAULT 0 CHECK (can_courses IN (0, 1)),&#10;  can_qr_codes INTEGER NOT NULL DEFAULT 0 CHECK (can_qr_codes IN (0, 1)),&#10;  can_practice_parties INTEGER NOT NULL DEFAULT 0 CHECK (can_practice_parties IN (0, 1)));" style="text;html=0;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;" parent="sql-reference-layer" vertex="1">
                    <mxGeometry x="60" y="6480" width="2000" height="680" as="geometry" />
                </mxCell>
                <mxCell id="sql-qr_codes" value="CREATE TABLE &quot;qr_codes&quot; (&#10;  id INTEGER PRIMARY KEY AUTOINCREMENT,&#10;  slug TEXT NOT NULL UNIQUE,&#10;  name TEXT NOT NULL,&#10;  destination_url TEXT NOT NULL,&#10;  active INTEGER NOT NULL DEFAULT 1 CHECK (active IN (0, 1)),&#10;  image_mode TEXT NOT NULL DEFAULT 'none' CHECK (image_mode IN ('none', 'logo', 'custom')),&#10;  image_path TEXT,&#10;  module_shape TEXT NOT NULL DEFAULT 'square' CHECK (module_shape IN ('square', 'circle')),&#10;  foreground_color TEXT NOT NULL DEFAULT '#1e293b',&#10;  eye_shape TEXT NOT NULL DEFAULT 'square' CHECK (eye_shape IN ('square', 'rounded', 'circle')),&#10;  eye_color TEXT NOT NULL DEFAULT '#1e293b',&#10;  logo_size INTEGER NOT NULL DEFAULT 25 CHECK (logo_size BETWEEN 15 AND 30),&#10;  logo_shape TEXT NOT NULL DEFAULT 'square' CHECK (logo_shape IN ('square', 'rounded', 'circle'))&#10;);" style="text;html=0;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;" parent="sql-reference-layer" vertex="1">
                    <mxGeometry x="60" y="7880" width="2000" height="680" as="geometry" />
                </mxCell>
                <mxCell id="sql-payment_presets" value="CREATE TABLE payment_presets (&#10;  id INTEGER PRIMARY KEY AUTOINCREMENT,&#10;  name TEXT NOT NULL CHECK (length(trim(name)) BETWEEN 1 AND 120),&#10;  amount_minor INTEGER NOT NULL CHECK (typeof(amount_minor) = 'integer' AND amount_minor BETWEEN 1 AND 99999999)&#10;);&#10;CREATE UNIQUE INDEX payment_presets_name_idx ON payment_presets (name COLLATE NOCASE);" style="text;html=0;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;" parent="sql-reference-layer" vertex="1">
                    <mxGeometry x="60" y="1130" width="2000" height="500" as="geometry" />
                </mxCell>
                <mxCell id="sql-payment_preset_courses" value="CREATE TABLE payment_preset_courses (&#10;  preset_id INTEGER NOT NULL REFERENCES payment_presets(id) ON DELETE CASCADE,&#10;  course_id INTEGER NOT NULL REFERENCES courses(id),&#10;  allowance INTEGER NOT NULL CHECK (typeof(allowance) = 'integer' AND allowance BETWEEN 1 AND 10000),&#10;  PRIMARY KEY (preset_id, course_id)&#10;);&#10;CREATE INDEX payment_preset_courses_course_idx ON payment_preset_courses (course_id);" style="text;html=0;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;" parent="sql-reference-layer" vertex="1">
                    <mxGeometry x="60" y="1340" width="2000" height="500" as="geometry" />
                </mxCell>
                <mxCell id="sql-classes" value="CREATE TABLE classes (&#10;  id INTEGER PRIMARY KEY AUTOINCREMENT,&#10;  course_id INTEGER NOT NULL REFERENCES courses(id),&#10;  class_date TEXT NOT NULL,&#10;  start_time TEXT NOT NULL,&#10;  end_time TEXT,&#10;  cancelled INTEGER NOT NULL DEFAULT 0 CHECK (cancelled IN (0, 1)),&#10;  cancelled_by TEXT REFERENCES admin_profiles(email),&#10;  cancelled_at TEXT,&#10;  UNIQUE (course_id, class_date, start_time)&#10;);&#10;CREATE TRIGGER cancellation_requires_no_attendance BEFORE UPDATE OF cancelled ON classes&#10;WHEN NEW.cancelled = 1 AND EXISTS (SELECT 1 FROM attendance WHERE class_id = NEW.id)&#10;BEGIN SELECT RAISE(ABORT, 'Class already has attendance'); END;" parent="sql-reference-layer" vertex="1" />
                <mxCell id="sql-practice_parties" value="CREATE TABLE practice_parties (&#10;  id INTEGER PRIMARY KEY AUTOINCREMENT,&#10;  starts_at TEXT NOT NULL,&#10;  starts_utc TEXT NOT NULL,&#10;  duration_minutes INTEGER NOT NULL CHECK (duration_minutes BETWEEN 1 AND 1440),&#10;  cancelled INTEGER NOT NULL DEFAULT 0 CHECK (cancelled IN (0, 1)),&#10;  revision INTEGER NOT NULL DEFAULT 0,&#10;  recorded_by TEXT NOT NULL REFERENCES admin_profiles(email),&#10;  recorded_at TEXT NOT NULL,&#10;  request_key TEXT NOT NULL UNIQUE&#10;, request_hash TEXT, last_request_key TEXT, last_request_hash TEXT);&#10;CREATE INDEX practice_parties_date_idx ON practice_parties (starts_at, id);&#10;CREATE TRIGGER practice_revision_matches BEFORE UPDATE OF revision ON practice_parties&#10;WHEN NEW.revision != OLD.revision + 1&#10;BEGIN SELECT RAISE(ABORT, 'Practice party changed. Reload before saving.'); END;" parent="sql-reference-layer" vertex="1" />
                <mxCell id="sql-practice_attendance" value="CREATE TABLE &quot;practice_attendance&quot; (&#10;  id INTEGER PRIMARY KEY AUTOINCREMENT,&#10;  student_id INTEGER NOT NULL REFERENCES students(id),&#10;  practice_id INTEGER NOT NULL REFERENCES practice_parties(id),&#10;  recorded_by TEXT NOT NULL REFERENCES admin_profiles(email),&#10;  recorded_at TEXT NOT NULL,&#10;  notes TEXT NOT NULL DEFAULT '',&#10;  donation_amount_minor INTEGER CHECK (donation_amount_minor IS NULL OR (typeof(donation_amount_minor) = 'integer' AND donation_amount_minor BETWEEN 1 AND 99999999)),&#10;  donation_paid_on TEXT,&#10;  donation_notes TEXT NOT NULL DEFAULT '',&#10;  donation_recorded_by TEXT REFERENCES admin_profiles(email),&#10;  donation_recorded_at TEXT,&#10;  donation_given_to_school INTEGER NOT NULL DEFAULT 0 CHECK (donation_given_to_school IN (0, 1)),&#10;  UNIQUE (student_id, practice_id),&#10;  CHECK (&#10;    (donation_amount_minor IS NULL AND donation_paid_on IS NULL AND donation_recorded_by IS NULL AND donation_recorded_at IS NULL AND donation_notes = '' AND donation_given_to_school = 0)&#10;    OR (donation_amount_minor IS NOT NULL AND donation_paid_on IS NOT NULL AND donation_recorded_by IS NOT NULL AND donation_recorded_at IS NOT NULL)&#10;  )&#10;);&#10;CREATE INDEX practice_attendance_donation_date_idx ON practice_attendance (donation_paid_on, id) WHERE donation_amount_minor IS NOT NULL;&#10;CREATE TRIGGER practice_attendance_keeps_donation BEFORE DELETE ON practice_attendance&#10;WHEN OLD.donation_amount_minor IS NOT NULL&#10;BEGIN SELECT RAISE(ABORT, 'Remove the donation before removing attendance.'); END;&#10;CREATE INDEX practice_attendance_party_idx ON practice_attendance (practice_id, id);" parent="sql-reference-layer" vertex="1" />
                <mxCell id="sql-school_payment_records" value="CREATE VIEW school_payment_records AS&#10;SELECT p.id, 'course' AS purpose, NULL AS practice_id, NULL AS practice_description,&#10;  p.student_id, p.paid_on, p.amount_minor, p.recorded_by, p.received_method, p.given_to_school&#10;FROM student_payments p&#10;UNION ALL&#10;SELECT a.id, 'practice_donation', a.practice_id, 'Practice party · ' || s.starts_at,&#10;  a.student_id, a.donation_paid_on, a.donation_amount_minor, a.donation_recorded_by, '', a.donation_given_to_school&#10;FROM practice_attendance a JOIN practice_parties s ON s.id = a.practice_id&#10;WHERE a.donation_amount_minor IS NOT NULL;" parent="sql-reference-layer" vertex="1" />
