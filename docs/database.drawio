                <mxCell id="admin-cancellations" value="" style="html=0;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;startArrow=ERone;endArrow=ERmany;strokeColor=#a78bfa;exitX=0;exitY=0.5;entryX=0;entryY=0.7692;" parent="1" source="admin_profiles" target="classes" edge="1">
                    <mxGeometry relative="1" as="geometry">
