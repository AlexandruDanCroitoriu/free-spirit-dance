                <mxCell id="school_payment_records-paid_on" value="paid_on : TEXT" parent="school_payment_records" vertex="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;fontSize=12;fillColor=#fff7ed;overflow=hidden;" tooltip="paid_on: TEXT">
