                    <mxGeometry x="0" y="44" width="560" height="28" as="geometry" />
                </mxCell>
                <mxCell id="payment_presets-name" value="name : TEXT  [NN]" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;fontSize=12;fillColor=#f0fdf4;overflow=hidden;" parent="payment_presets" vertex="1" tooltip="name: TEXT; NOT NULL">
