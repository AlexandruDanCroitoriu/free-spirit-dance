                <mxCell id="payment_preset_courses-course_id" value="course_id : INTEGER  [PK, FK]" style="html=0;fontFamily=Helvetica;text;align=left;verticalAlign=middle;spacingLeft=12;fontSize=14;" parent="payment_preset_courses" vertex="1">
                    <mxGeometry as="geometry" x="0" y="70" width="420" height="28" />
                </mxCell>
                <mxCell id="payment_preset_courses-allowance" value="allowance : INTEGER" style="html=0;fontFamily=Helvetica;text;align=left;verticalAlign=middle;spacingLeft=12;fontSize=14;" parent="payment_preset_courses" vertex="1">
                    <mxGeometry as="geometry" x="0" y="98" width="420" height="28" />
                </mxCell>
                <mxCell id="sql-payment_preset_courses" value="CREATE TABLE payment_preset_courses (&#10;  preset_id INTEGER NOT NULL REFERENCES payment_presets(id) ON DELETE CASCADE,&#10;  course_id INTEGER NOT NULL REFERENCES courses(id),&#10;  allowance INTEGER NOT NULL CHECK (typeof(allowance) = 'integer' AND allowance BETWEEN 1 AND 10000),&#10;  PRIMARY KEY (preset_id, course_id)&#10;);&#10;CREATE INDEX payment_preset_courses_course_idx ON payment_preset_courses (course_id);" style="text;html=0;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;" parent="sql-reference-layer" vertex="1">
                    <mxGeometry as="geometry" x="60" y="1340" width="2000" height="500" />
                </mxCell>
                <mxCell id="classes" value="classes" style="html=0;fontFamily=Helvetica;swimlane;startSize=42;horizontal=1;rounded=1;arcSize=8;collapsible=0;fontSize=18;fontStyle=1;fillColor=#eff6ff;strokeColor=#60a5fa;" parent="1" vertex="1">
